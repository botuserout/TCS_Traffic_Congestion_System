{
  "name": "tcs-traffic-congestion-system",
  "version": "1.0.0",
  "description": "Real-time Traffic Congestion System using YOLOv8 and ByteTrack",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/run-backend.js",
    "dev:frontend": "npm --prefix frontend run dev:frontend",
    "install:all": "node scripts/install-deps.js",
    "install:frontend": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}