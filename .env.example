# ============================================
# TCS - Traffic Congestion System
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env       (Mac/Linux)
#   copy .env.example .env     (Windows)
# ============================================

# --- Camera Configuration ---
# Camera device index (default: 0 on Windows, 1 on Mac to skip Continuity Camera)
# Uncomment and set if needed:
# TCS_CAMERA_INDEX=0

# --- Email Alert Configuration ---
TCS_SENDER_EMAIL=harshrajs1k@gmail.com
TCS_EMAIL_APP_PASSWORD=your_gmail_app_password_here
TCS_RECEIVER_EMAIL=rajharsh.23.cse@iite.indusuni.ac.in, rakeshjena.23.cse@iite.indusuni.ac.in

# --- Telegram Bot Configuration ---
TCS_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TCS_TELEGRAM_CHAT_ID=your_chat_id_here

# --- Security ---
# JWT secret key for authentication tokens (change this in production!)
TCS_JWT_SECRET=tcs_secret_jwt_key_super_secure_987213

# Default admin password (only used on first DB initialization)
TCS_DEFAULT_ADMIN_PASSWORD=Admin@TCS123

# --- CORS ---
# Allowed frontend origins (comma-separated). Defaults to Vite dev server ports.
# TCS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
